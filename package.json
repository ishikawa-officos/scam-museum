{
  "name": "scam-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force --noEmit",
    "make-charts": "node scripts/make-charts.mjs",
    "make-brand-images": "node scripts/make-brand-images.mjs",
    "build-fonts": "node scripts/build-fonts.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "check-fonts": "node scripts/check-fonts.mjs",
    "export-scenario": "node --experimental-strip-types --no-warnings scripts/export-scenario.mjs",
    "check-release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
