# Cloudflare Pages の既定は全ファイル max-age=0, must-revalidate で、
# 毎回検証の往復が発生する。ファイル名にハッシュが入っているものは
# 中身が変われば名前も変わるので、長期に固定してよい。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 画像はファイル名が固定なので immutable にはしない。
# 差し替えたときに古いものが残り続けると気づけないため。
/assets/romance/*
  Cache-Control: public, max-age=86400
/assets/itadaki/*
  Cache-Control: public, max-age=86400
/assets/police/*
  Cache-Control: public, max-age=86400
/assets/group/*
  Cache-Control: public, max-age=86400
